{
  "name": "readyornot-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vietnamese source-grounded ReadyOrNot learning handbook and native gun laboratory",
  "engines": { "node": ">=22" },
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "docs:prepare": "node scripts/prepare.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev . --host 127.0.0.1",
    "docs:build": "npm run docs:prepare && vitepress build .",
    "docs:check": "node scripts/check.mjs",
    "docs:preview": "vitepress preview . --host 127.0.0.1"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "mermaid": "11.16.1"
  }
}
